{
  "name": "@collidor/ui",
  "version": "0.1.0",
  "description": "High-performance Web Component UI library with Golden Ratio relative spacing and OKLCH derived colors",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collidor/ui.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Alykam Burdzaki <alykam@gmail.com> (https://alykam.com)",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "test": "vp test",
    "build:docs": "npm --prefix docs-site run build",
    "dev:docs": "npm --prefix docs-site run dev"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/collidor/ui/issues"
  },
  "homepage": "https://github.com/collidor/ui#readme"
}
