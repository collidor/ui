{
    "name": "@collidor/ui",
    "version": "0.1.0",
    "description": "High-performance Web Component UI library with Golden Ratio relative spacing and OKLCH derived colors",
    "files": [
        "dist",
        "src",
        "!src/__tests__"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./tokens.css": "./src/tokens.css"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/collidor/ui.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": "Alykam Burdzaki <alykam@gmail.com> (https://alykam.com)",
    "license": "MIT",
    "dependencies": {
        "lit": "^3.3.0"
    },
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "test": "vp test",
        "release": "semantic-release",
        "sync:jsr": "deno run --allow-read --allow-write ./sync.ts",
        "build:docs": "npm --prefix docs-site run build",
        "dev:docs": "npm --prefix docs-site run dev"
    },
    "devDependencies": {
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/exec": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/node": "^24.13.4",
        "semantic-release": "^24.2.3",
        "typescript": "~7.0.2",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:"
    },
    "directories": {
        "doc": "docs"
    },
    "keywords": [],
    "bugs": {
        "url": "https://github.com/collidor/ui/issues"
    },
    "homepage": "https://github.com/collidor/ui#readme"
}